      "params": [
        { "name": "caller", "type": "Pubkey" },
        { "name": "amount", "type": "u64" }
      ],
      "result_semantics": { "kind": "return_code", "success_codes": [0] }
    },
    {
      "name": "get_cross_account",
      "opcode": 49,
