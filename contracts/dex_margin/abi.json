      "result_semantics": { "kind": "return_value" }
    },
    {
      "name": "finalize_and_activate_margin_v2",
      "opcode": 50,
      "description": "Atomically seal exact Funding V2 and Cross V2 migration counts and activate both engines at one paused governance boundary. Existing networks cannot use the separate activation paths.",
