# Moss binds to loopback and must be published through the authenticated/rate-limited HTTPS edge.
MOSS_PROVIDER_LISTEN=127.0.0.1:9120
MOSS_PROVIDER_DATA_DIR=/var/lib/lichen/moss
LICHEN_RPC_URL=http://127.0.0.1:8899
MOSS_STORAGE_CONTRACT=REPLACE_WITH_GENESIS_MOSS_STORAGE_ADDRESS
MOSS_PROVIDER_KEYPAIR=/var/lib/lichen/moss/provider-keypair.json
MOSS_PROVIDER_PUBLIC_BASE_URL=https://testnet-moss.lichen.network
MOSS_PROVIDER_ALLOWED_ORIGINS=https://marketplace.lichen.network,https://wallet.lichen.network
MOSS_PROVIDER_REQUIRE_SIGNATURE=true

# 256 MiB/object, 50 GiB/provider, 512 MiB/wallet/hour.
MOSS_PROVIDER_MAX_OBJECT_BYTES=268435456
MOSS_PROVIDER_MAX_TOTAL_BYTES=53687091200
MOSS_PROVIDER_OWNER_HOURLY_BYTES=536870912
MOSS_PROVIDER_STAGED_TTL_SECS=3600
MOSS_PROVIDER_RECONCILE_SECS=5
RUST_LOG=lichen_moss_provider=info,tower_http=info
